  },
  "dependencies": {
    "@openai/agents": "^0.13.5",
    "@yiku/evals": "workspace:*",
    "@yiku/sandbox": "workspace:*",
    "shell-quote": "^1.10.0",
    "zod": "^4.4.3"
  }
