{
  "name": "@yiku/hooks",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rm -rf dist",
    "test": "vitest run --root ../.. packages/hooks/tests",
    "watch": "tsc -b --watch --preserveWatchOutput"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  }
}
