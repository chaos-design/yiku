{
  "name": "@yiku/atomic-flow",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fold": {
      "development": "./src/fold.ts",
      "types": "./dist/fold.d.ts",
      "import": "./dist/fold.js"
    },
    "./browser": {
      "development": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rm -rf dist",
    "test": "vitest run --root ../.. packages/atomic-flow/tests",
    "watch": "tsc -b --watch --preserveWatchOutput"
  }
}
